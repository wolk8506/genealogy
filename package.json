{
  "name": "genealogy-react",
  "productName": "Genealogy",
  "version": "1.14.0",
  "main": "src/main/index.cjs",
  "type": "module",
  "description": "Генеалогическое приложение",
  "author": "nebula.9371",
  "license": "Proprietary",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build:react": "vite build",
    "build:electron": "electron-builder --publish never",
    "predist:mac": "node build/dmg/make-background.mjs",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dmg:background": "node build/dmg/make-background.mjs",
    "win:assets": "node build/win/make-assets.mjs",
    "predist:win": "node build/win/make-assets.mjs",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "mock:library": "node scripts/make-mock-library/make-mock-library.mjs",
    "create:icon:macos": "node scripts/create_Icom_MacOS/create-Imon-MacOS.mjs",
    "build": "npm run build:react && npm run build:electron",
    "start": "electron .",
    "test": "vitest run --exclude tests/main/mockLibraryImport.test.mjs --exclude tests/main/importRoundTrip.test.mjs",
    "test:unit": "npm test",
    "test:full": "vitest run",
    "test:watch": "vitest --exclude tests/main/mockLibraryImport.test.mjs --exclude tests/main/importRoundTrip.test.mjs",
    "test:watch:full": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/main/mockLibraryImport.test.mjs --exclude tests/main/importRoundTrip.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@milkdown/components": "^7.23.0",
    "@milkdown/core": "^7.23.0",
    "@milkdown/ctx": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/plugin-block": "^7.23.0",
    "@milkdown/plugin-tooltip": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@milkdown/theme-nord": "^7.23.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@vladmandic/face-api": "^1.7.15",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.1.1",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.23",
    "dictionary-ru": "^3.0.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "exif-parser": "^0.1.12",
    "exifreader": "^4.54.0",
    "follow-redirects": "^1.16.3",
    "framer-motion": "^14.12.0",
    "fs-extra": "^11.4.1",
    "heic2any": "^0.0.4",
    "image-size": "^2.1.0",
    "leaflet": "^1.9.4",
    "libheif-js": "^1.23.5",
    "node-fetch": "^3.3.2",
    "node-stream-zip": "^1.16.0",
    "notistack": "^3.0.2",
    "nspell": "^2.1.5",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "react-easy-crop": "^6.2.5",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-virtuoso": "^4.18.21",
    "sharp": "^0.35.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "asar": "^3.2.0",
    "baseline-browser-mapping": "^2.11.35",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "node-abi": "^4.40.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.nebula9371.genealogy",
    "productName": "Genealogy",
    "artifactName": "${productName}-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "wolk8506",
        "repo": "genealogy"
      }
    ],
    "icon": "build/icons/icon",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "src/main/**",
      "src/main/handlers/**",
      "src/main/index.cjs",
      "preload.js",
      "package.json",
      "CHANGELOG.md",
      "USER_GUIDE.md"
    ],
    "extraMetadata": {
      "main": "src/main/index.cjs"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "identity": "Genealogy Self-Sign"
    },
    "dmg": {
      "icon": "build/icons/dmg-volume.icns",
      "title": "Установка Genealogy",
      "background": "build/dmg/background.tiff",
      "window": {
        "width": 600,
        "height": 693
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 172,
          "y": 305,
          "type": "file"
        },
        {
          "x": 427,
          "y": 305,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "Genealogy-Setup-${version}.${ext}",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/win/installerIcon.ico",
      "uninstallerIcon": "build/win/installerIcon.ico",
      "installerHeader": "build/win/installerHeader.bmp",
      "installerSidebar": "build/win/installerSidebar.bmp"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons/256x256.png"
    }
  }
}
